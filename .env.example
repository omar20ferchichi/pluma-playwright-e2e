# Copy to .env and fill in values. Never commit real credentials.

PLUMA_BASE_URL=https://app.pluma.ai
PLUMA_HEADLESS=true
PLUMA_SLOW_MO_MS=0

# Recording of every test: on | off | retain-on-failure | on-first-retry (defaults: trace on, video off)
PLUMA_TRACE=
PLUMA_VIDEO=

# Email/password account (not Google sign-in). Use a dedicated test account.
PLUMA_EMAIL=
PLUMA_PASSWORD=
